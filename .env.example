# ═══════════════════════════════════════════════════════════════
# SYNAPSE ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# The platform uses BYOK (Bring Your Own Key) — most AI keys are
# optional at the PLATFORM level and provided by individual users.
# ═══════════════════════════════════════════════════════════════

# ── Database (REQUIRED) ────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/synapse

# ── Session Secret (REQUIRED) ─────────────────────────────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# ── Admin Configuration ────────────────────────────────────────
# Comma-separated emails for admin access (content regeneration, etc.)
ADMIN_EMAILS=jpkorstad@gmail.com

# ── Platform AI Keys (OPTIONAL — Community Pool Only) ─────────
# These keys fund the Community Compute Pool — a shared budget
# for users who can't bring their own keys.
# Set POOL_DAILY_BUDGET to cap spending ($/day).
# IF YOU LEAVE THESE EMPTY, community pool is disabled (safe default).

# Community pool daily budget cap in USD (hard limit)
POOL_DAILY_BUDGET=5

# Platform-level AI keys (used ONLY for community pool generation)
XAI_API_KEY=
AI_INTEGRATIONS_GEMINI_API_KEY=
AI_INTEGRATIONS_OPENAI_API_KEY=

# ── xAI (Grok) Course Generation ──────────────────────────────
# Primary model for course content. Override at runtime via XAI_COURSE_MODEL.
XAI_COURSE_MODEL=grok-4.20-reasoning

# ── Gemini Fallback ────────────────────────────────────────────
GEMINI_COURSE_MODEL=gemini-2.0-flash
AI_INTEGRATIONS_GEMINI_BASE_URL=

# ── OpenAI Fallback ────────────────────────────────────────────
AI_INTEGRATIONS_OPENAI_BASE_URL=

# ── Hugging Face (TTS fallback + optional HF model provider) ────
# Used for server-side Qwen3-TTS (via Gradio ZeroGPU) and HF Inference API fallback.
# Get a free read token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# ── Server ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Encryption Key (for storing user BYOK keys securely) ───────
# Generate with: openssl rand -hex 32
# Used to AES-256 encrypt user-submitted API keys at rest.
BYOK_ENCRYPTION_KEY=

# ── Prepaid Inference Lane (OPTIONAL — BYOK stays the default) ──
# Optional paid fallback for users with no API key / no local Ollama.
# Prepaid credits only — the platform NEVER fronts someone else's compute.
# Every generation debits the user's prefunded balance at a fixed sell price.

# OpenRouter key the PLATFORM uses to serve prepaid generations.
# This is the operator's prepaid OpenRouter account.
OPENROUTER_API_KEY=

# Pinned model users get when buying credits (single model — no arbitrary-model UI).
PREPAID_MODEL=deepseek/deepseek-chat

# Sell-price margin over operator cost (default 1.3x). Define in ONE place.
# Sell price of a generation = (pinned-model cost-per-token) x PREPAID_MARGIN,
# rounded up to a safe floor.
PREPAID_MARGIN=1.3

# Operator per-token cost, USD per 1M tokens, for the pinned model.
# DEFAULTS ARE CONSERVATIVE (upper bounds). Tune DOWN only after verifying
# current OpenRouter pricing — never below published cost.
PREPAID_INPUT_USD_PER_1M=0.5
PREPAID_OUTPUT_USD_PER_1M=2.0

# Minimum charge per generation, in cents (floor so tiny requests don't round to 0).
PREPAID_MIN_SELL_CENTS=5

# ── Prepaid hardening limits ──────────────────────────────────
# Hard ceiling on a single user's balance (defense-in-depth; legit buys are $5-$20).
PREPAID_MAX_BALANCE_CENTS=20000

# Operator-side daily spend ceiling (OPERATOR cost in cents, independent of user
# balances). Once the lane has spent this much today, further paid generations
# are refused until tomorrow. Set 0 to disable.
PREPAID_DAILY_SPEND_LIMIT_CENTS=5000

# Rate limits (per minute). Per-user generation + global aggregate.
PREPAID_RATE_LIMIT_PER_MIN=10
PREPAID_GLOBAL_RATE_LIMIT_PER_MIN=100

# Hard clamp on output tokens per paid request (defense-in-depth).
PREPAID_MAX_TOKENS=8192

# ── Stripe (prepaid credit purchases) ──────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Absolute base URL used for Stripe checkout success/cancel redirects.
# Falls back to the request Origin, then https://synapsejourney.org
APP_BASE_URL=
